# ==========================================================
# Paths
# ==========================================================

exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP


$hypr = ~/.config/hypr
$hl = $hypr/hyprland
$cConf = ~/.config/caelestia

# ==========================================================
# Theme / Variables
# ==========================================================

exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user start hyprland-session.target

exec = cp -Lf $hypr/scheme/default.conf $hypr/scheme/current.conf

source = $hypr/scheme/current.conf
source = $hypr/variables.conf

# User variables
source = $cConf/hypr-vars.conf

# ==========================================================
# Monitor Configuration
# ==========================================================

# This file is generated by monitor-setup.sh
# source = $hypr/hyprland/monitors.conf

# Detect monitors and generate monitors.conf
exec-once = ~/.config/hypr/scripts/monitor-setup.sh

# ==========================================================
# Generate additional configs
# ==========================================================

exec = $hypr/scripts/configs.fish $cConf

# ==========================================================
# Core Hyprland Configs
# ==========================================================

source = $hl/env.conf
source = $hl/general.conf
source = $hl/input.conf
source = $hl/misc.conf
source = $hl/animations.conf
source = $hl/decoration.conf
source = $hl/group.conf
source = $hl/execs.conf
source = $hl/rules.conf
source = $hl/gestures.conf
source = $hl/keybinds.conf
source = $hl/scrolling.conf 
# source = $hl/monitor.conf # is for each pc unique

# ==========================================================
# User Overrides
# ==========================================================

source = $cConf/hypr-user.conf

# Fallback configuration
monitor = , preferred, auto, 1
